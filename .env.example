# ==============================================================================
# 1. DOMAIN PROFILE & BACKEND ENGINE
# ==============================================================================

# --- Domain Profile Configuration ---
# Select the active domain content pack (subdirectory under profiles/).
# Each profile encapsulates prompts, streaming markers, keywords, and display
# strings for a specific domain (EU AI Act, Vietnamese law, company policies, ...).
# Options:
# RAG_PROFILE=financial_compliance
RAG_PROFILE=financial_compliance

# --- Backend Engine Configuration ---
# Options:
# RAG_BACKEND=vector_chunking   # Neural hybrid dense+sparse vector (Qdrant + BGE reranker)
RAG_BACKEND=page_index          # SOTA vectorless tree navigation (hierarchical page index)


# ==============================================================================
# 2. LLM PROVIDER & MODEL ROUTING CONFIGURATION
# ==============================================================================
# Supported providers: ollama, openai, anthropic, google, zai
#
# Enable in-memory exact-match LLM response cache (true/false)
LLM_CACHE_ENABLED=true
# Path to log JSON prompts sent to the LLM for debugging (empty = disabled)
LLM_PROMPT_LOG_PATH=""

# ------------------------------------------------------------------------------
# Alternative LLM Provider Options (Commented out)
# ------------------------------------------------------------------------------
# To switch providers, comment out the active OpenAI block below and uncomment
# the chosen provider block:
#
# --- Option 1: Ollama (Local) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_MODEL_REQUEST_1=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_MODEL_REQUEST_2=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_MODEL_REQUEST_3=qwen3:4b-instruct-2507-q4_K_M
#
# --- Option 2: Anthropic-compatible endpoint ---
# LLM_PROVIDER=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_REQUEST_1=
# ANTHROPIC_MODEL_REQUEST_2=
# ANTHROPIC_MODEL_REQUEST_3=
#
# --- Option 3: Anthropic Direct (Cloud) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_REQUEST_1=claude-sonnet-5-5
# ANTHROPIC_MODEL_REQUEST_2=claude-sonnet-5-5
# ANTHROPIC_MODEL_REQUEST_3=claude-sonnet-5-5
#
# --- Option 4: Google Gemini (Cloud) ---
# LLM_PROVIDER=google
# GOOGLE_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_MODEL=gemini-2.5-flash
# GOOGLE_MODEL_REQUEST_1=gemini-2.5-flash
# GOOGLE_MODEL_REQUEST_2=gemini-2.5-flash
# GOOGLE_MODEL_REQUEST_3=gemini-2.5-flash
#
# --- 3-Tier Request Model Routing (Optional Generic Fallbacks) ---
# Maps directly to the 3-Stage Progressive Disclosure pipeline:
# - Stage 1: Keyword extraction, query rewrite & retrieval planning
# - Stage 2: Symbolic calculation gate (building Python Decimal formulas)
# - Stage 3: Final audit-grade compliance reasoning & report synthesis
# Backward-compatible: if omitted (or all 3 set to the same model), all stages
# share the single base model configured above (`<PROVIDER>_MODEL`).
# LLM_MODEL_REQUEST_1=gpt-4o-mini
# LLM_MODEL_REQUEST_2=gpt-4o-mini
# LLM_MODEL_REQUEST_3=gpt-4o

# ------------------------------------------------------------------------------
# Active LLM Provider (Default: OpenAI)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=<your-openai-key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>
# OPENAI_MODEL=gpt-4o
OPENAI_MODEL_REQUEST_1=gpt-5-mini
OPENAI_MODEL_REQUEST_2=gpt-5.4
OPENAI_MODEL_REQUEST_3=gpt-5.4-mini
OPENAI_TEMPERATURE=0
OPENAI_SEED=42


# ==============================================================================
# 3. STORAGE & CORPUS DIRECTORIES
# ==============================================================================
# Directory containing raw corpus documents (.pdf, .docx, .txt, .md)
DOCS_DIR=data_docs

# Paths for vector & parent document storage (used by vector_chunking and shared indexes)
PARENT_STORE_PATH=data/compliance_rag/parent_store
QDRANT_PATH=data/compliance_rag/qdrant_db
CHILD_COLLECTION=nav_compliance_children


# ==============================================================================
# 4. RETRIEVAL & SEARCH CONFIGURATION
# ==============================================================================
# --- Alternative Vector Chunking Embedding & Reranker Options (Commented out) ---
# (Note: Re-run ingestion with --clean if you change embedding models: make ingest CLEAN=1)
#
# Option A (Default Local):
# VECTOR_CHUNKING_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
#
# Option B (Azure OpenAI - Enterprise EU Compliant):
# VECTOR_CHUNKING_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-02-01
#
# Option C (Direct OpenAI API):
# VECTOR_CHUNKING_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMBEDDING_DIMENSIONS=768
#
# Sparse & Reranker models for vector_chunking:
# SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# RERANKER_MODEL=BAAI/bge-reranker-base

# --- Active Retrieval Parameters ---
# Default number of parent documents returned by the search_documents tool
DEFAULT_SEARCH_LIMIT=5
# Candidate pool limit for retrieval ranking
RETRIEVAL_CANDIDATES=12


# ==============================================================================
# 5. HARDWARE ACCELERATION & OFFLINE SETTINGS
# ==============================================================================
# Device options: auto (default), cuda, mps, cpu
# - auto: Automatically picks optimal device (NVIDIA CUDA -> Apple Silicon MPS -> CPU)
# - cuda: Enforces NVIDIA GPU acceleration (Linux/Windows server)
# - mps: Enforces Apple Silicon GPU acceleration (macOS Metal)
# - cpu: Runs completely on CPU (Docker, cloud VMs without GPU)
# (Note: On macOS, reranker defaults to CPU to avoid Metal GPU threading conflicts)
DEVICE=auto

# Offline execution flags (prevents unwanted Hugging Face downloads when models are cached)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1


# ==============================================================================
# 6. PIPELINE THRESHOLDS (AGENT & HISTORY)
# ==============================================================================
# Maximum history messages retained before summarization (default: 16)
MAX_HISTORY_MESSAGES=16
# Maximum history tokens before summarization (default: 25000)
MAX_HISTORY_TOKENS=25000
# Token threshold to trigger research context compression (default: 85000)
COMPRESS_TOKEN_THRESHOLD=85000
# Context compression growth factor based on existing summary size (default: 0.9)
TOKEN_GROWTH_FACTOR=0.9
# Maximum tool calls allowed per single agent turn (default: 8)
MAX_TOOL_CALLS=8
# Maximum orchestrator iterations (default: 5)
MAX_ITERATIONS=5
# LangGraph recursion limit per conversation (default: 50)
RECURSION_LIMIT=50
# Maximum output/completion tokens allowed for LLM responses (prevents truncation in reasoning models, default: 16384)
MAX_OUTPUT_TOKENS=16384


# ==============================================================================
# 7. INTERNET SEARCH, WEB SERVER & CHAT PERSISTENCE
# ==============================================================================
# --- Internet Search Configuration ---
# Maximum timeout (seconds) for each DuckDuckGo query (default: 30)
SEARCH_TIMEOUT_SECONDS=30
# Maximum number of results per internet search query (default: 3)
SEARCH_MAX_RESULTS=3

# --- Web Server Configuration ---
# Host and port for the Gradio/FastAPI web interface (defaults: 127.0.0.1:7860)
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# --- Chat History Persistence ---
# SQLite database path for persisting conversations (relative path)
CHAT_HISTORY_PATH=db/chat_history.db
# Retention cap: maximum number of recent conversations kept (oldest pruned, default: 20)
MAX_STORED_CONVERSATIONS=20